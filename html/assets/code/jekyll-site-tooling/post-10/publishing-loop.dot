digraph PublishingLoop {
  graph [bgcolor="#111923", pad="0.38", rankdir="TB", nodesep="0.48", ranksep="0.65", fontname="Helvetica", fontcolor="#edf2f5", label="The publishing loop", labelloc="t", fontsize=20];
  node [shape=box, style="rounded,filled", color="#587080", fillcolor="#20303d", fontcolor="#f4f5f6", fontname="Helvetica", fontsize=12, margin="0.20,0.13"];
  edge [color="#9db1bc", arrowsize=0.7, penwidth=1.5];
  article [label="Standalone article"];
  series [label="Series installment"];
  project [label="Project update"];
  review [label="Human editorial review\nprose, placement, accuracy", fillcolor="#513d28", color="#d4a660"];
  local [label="Local preview and focused checks\nassets, metadata, URLs, changed files"];
  decision [label="Human commit + push decision", fillcolor="#513d28", color="#d4a660"];
  pages [label="Pages build and deployment", fillcolor="#263958", color="#80a6d7"];
  public [label="Check the served page\nroute, asset, redirect destination", fillcolor="#234243", color="#73b8b5"];
  discussion [label="Public discussion\nGiscus / GitHub Discussions"];
  mail [label="Private message\ncontact page -> mail-client draft"];
  { rank=same; article; series; project; }
  { rank=same; discussion; mail; }
  article -> review;
  series -> review;
  project -> review;
  review -> local -> decision -> pages -> public;
  public -> discussion [style=dashed, label="reader chooses", fontcolor="#d4a660"];
  public -> mail [style=dashed, label="reader chooses", fontcolor="#d4a660"];
}
