digraph ObservationBoundaries {
  graph [bgcolor="#111923", pad="0.38", rankdir="TB", nodesep="0.42", ranksep="0.62", fontname="Helvetica", fontcolor="#edf2f5", label="What happens after the build?", labelloc="t", fontsize=20];
  node [shape=box, style="rounded,filled", color="#587080", fillcolor="#20303d", fontcolor="#f4f5f6", fontname="Helvetica", fontsize=12, margin="0.19,0.13"];
  edge [color="#9db1bc", arrowsize=0.7, penwidth=1.5];
  source [label="Source tree\nposts, metadata, assets", fillcolor="#513d28", color="#d4a660"];
  build [label="Pages build and deploy\nartifact accepted", fillcolor="#263958", color="#80a6d7"];
  public [label="Served public site\nreader-facing HTTP", fillcolor="#263958", color="#80a6d7"];
  crawl [label="Sitemap crawler\nserved same-host links + images"];
  monitor [label="Reliability monitor\nsource-derived pages + external links"];
  review [label="Investigate results\nstatus, destination, context", fillcolor="#234243", color="#73b8b5"];
  { rank=same; crawl; monitor; }
  source -> build -> public;
  public -> crawl [style=dashed, color="#d4a660", label="when run", fontcolor="#d4a660"];
  public -> monitor [style=dashed, color="#d4a660", label="when run", fontcolor="#d4a660"];
  crawl -> review;
  monitor -> review;
}
