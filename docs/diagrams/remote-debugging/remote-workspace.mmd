flowchart TB
    EDITOR["Local editor window"]
    SSH["Remote SSH connection"]
    SERVER["Editor server and extensions<br/>under the target account"]
    PROJECT["Remote project files"]
    PYTHON["Remote Python process<br/>launched by the editor"]

    EDITOR --> SSH --> SERVER
    SERVER --> PROJECT
    SERVER --> PYTHON
    PROJECT --> PYTHON

    classDef client fill:#e0f2fe,stroke:#0369a1,color:#0c4a6e,stroke-width:2px;
