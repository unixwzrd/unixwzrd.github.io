#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "open3"

root = File.expand_path("../..", __dir__)
source = File.join(root, "html")
output_dir = File.join(root, "docs", "diagrams", "site-architecture")
dot_path = File.join(output_dir, "jekyll-template-dependencies.dot")
svg_path = File.join(output_dir, "jekyll-template-dependencies.svg")

layout_files = Dir[File.join(source, "_layouts", "*.html")].sort
include_files = Dir[File.join(source, "_includes", "*.html")].sort
template_files = layout_files + include_files

node_id = lambda do |kind, name|
  %("#{kind}:#{name.gsub('"', '\\"')}")
end

dot_escape = lambda do |text|
  text.to_s.gsub("\\", "\\\\").gsub('"', '\\"')
end

nodes = {}
edges = []

layout_files.each do |path|
  name = File.basename(path)
  nodes[["layout", name]] = "_layouts/#{name}"
end

layout_files.each do |path|
  text = File.read(path)
  name = File.basename(path)
  front_matter = text.match(/\A---\s*\n(.*?)\n---\s*\n/m)&.captures&.first
  parent = front_matter&.match(/^layout:\s*["']?([^"'\s]+)["']?\s*$/)&.captures&.first
  next unless parent

  parent_name = "#{parent}.html"
  nodes[["layout", parent_name]] ||= "_layouts/#{parent_name}"
  edges << ["layout", name, "layout", parent_name, "extends"]
end

template_files.each do |path|
  text = File.read(path)
  source_kind = path.include?("/_layouts/") ? "layout" : "include"
  source_name = File.basename(path)

  text.to_enum(:scan, /\{%-?\s*include\s+([^\s%]+?)(?:\s|%)/).each do
    match = Regexp.last_match
    include_name = match[1].delete('"\'')
    next if include_name.include?("{{")

    line = text[0...match.begin(0)].count("\n") + 1
    nodes[["include", include_name]] ||= "_includes/#{include_name}"
    edges << [source_kind, source_name, "include", include_name, "include L#{line}"]
  end
end

reachable = nodes.keys.select { |kind, _name| kind == "layout" }
reachable_lookup = reachable.to_h { |node| [node, true] }
loop do
  additions = edges.filter_map do |from_kind, from_name, to_kind, to_name, _label|
    next unless reachable_lookup[[from_kind, from_name]]

    [to_kind, to_name]
  end.reject { |node| reachable_lookup[node] }
  break if additions.empty?

  additions.each do |node|
    reachable << node
    reachable_lookup[node] = true
  end
end
nodes.select! { |node, _label| reachable_lookup[node] }
edges.select! { |from_kind, from_name, to_kind, to_name, _label| reachable_lookup[[from_kind, from_name]] && reachable_lookup[[to_kind, to_name]] }

lines = []
lines << "// Generated by utils/bin/render-jekyll-template-graph. Do not edit by hand."
lines << "// Conditional Liquid branches appear together in this static dependency graph."
lines << "digraph jekyll_templates {"
lines << "  graph [rankdir=LR, bgcolor=\"transparent\", pad=\"0.25\", nodesep=\"0.35\", ranksep=\"0.8\", fontname=\"Helvetica\", label=\"Jekyll layout and include dependencies\\nStatic references; conditional branches are not simultaneous\", labelloc=t, fontsize=18, fontcolor=\"#d8dee9\"];"
lines << "  node [shape=box, style=\"rounded,filled\", fontname=\"Helvetica\", fontsize=10, color=\"#6b7280\", fontcolor=\"#f3f4f6\", fillcolor=\"#111827\", margin=\"0.12,0.08\"];"
lines << "  edge [fontname=\"Helvetica\", fontsize=8, color=\"#9ca3af\", fontcolor=\"#cbd5e1\", arrowsize=0.7];"
lines << ""
lines << "  subgraph cluster_layouts {"
lines << "    label=\"Layouts\"; color=\"#2563eb\"; fontcolor=\"#93c5fd\"; style=\"rounded\";"
nodes.select { |(kind, _name), _label| kind == "layout" }.sort.each do |(kind, name), label|
  lines << "    #{node_id.call(kind, name)} [label=\"#{dot_escape.call(label)}\", fillcolor=\"#172554\", color=\"#3b82f6\"];"
end
lines << "  }"
lines << ""
lines << "  subgraph cluster_includes {"
lines << "    label=\"Includes\"; color=\"#059669\"; fontcolor=\"#6ee7b7\"; style=\"rounded\";"
nodes.select { |(kind, _name), _label| kind == "include" }.sort.each do |(kind, name), label|
  lines << "    #{node_id.call(kind, name)} [label=\"#{dot_escape.call(label)}\"];"
end
lines << "  }"
lines << ""
edges.uniq.sort.each do |from_kind, from_name, to_kind, to_name, label|
  color = label == "extends" ? "#60a5fa" : "#9ca3af"
  lines << %(  #{node_id.call(from_kind, from_name)} -> #{node_id.call(to_kind, to_name)} [label="#{dot_escape.call(label)}", color="#{color}"];)
end
lines << "}"

FileUtils.mkdir_p(output_dir)
File.write(dot_path, lines.join("\n") + "\n")

stdout, stderr, status = Open3.capture3("dot", "-Tsvg", dot_path, "-o", svg_path)
unless status.success?
  warn stdout unless stdout.empty?
  warn stderr unless stderr.empty?
  abort "Graphviz rendering failed"
end

puts "Wrote #{dot_path.sub("#{root}/", "")}"
puts "Wrote #{svg_path.sub("#{root}/", "")}"
